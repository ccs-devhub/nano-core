# Bot runtime (required)
DISCORD_TOKEN=discord_bot_token
CLIENT_ID=discord_application_client_id

# MCP bridge (optional; the endpoint stays down without it)
NANO_MCP_TOKEN=generate_with_openssl_rand_hex_32

# Web dashboard (required only when web.enabled is true).
# Developer Portal > your application > OAuth2 > Client Secret.
# Also add <base>/auth/callback as an OAuth2 redirect URI there
# (local dev: http://127.0.0.1:4777/auth/callback).
DISCORD_CLIENT_SECRET=discord_oauth2_client_secret

# The ONLY user allowed to see + edit host-tier dashboard config
BOT_OWNER_ID=your_discord_user_id
