{
  "name": "@ccs-devhub/nano-core",
  "version": "0.5.0",
  "description": "Lightweight, free-software modular core for Discord bots, designed for simple injection of commands and features, with a strong focus on adaptability and community-driven collaboration.",
  "author": {
    "name": "Cyber Code Syndicate (CCS)",
    "url": "https://github.com/ccs-devhub"
  },
  "maintainers": [
    {
      "name": "Cristian D. Moreno - Kyonax",
      "url": "https://github.com/kyonax"
    }
  ],
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "modular",
    "bot-core",
    "cyber-code-syndicate",
    "ccs"
  ],
  "license": "MPL-2.0",
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "directories": {
    "doc": "docs",
    "test": "tests",
    "lib": "src"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "vite --config src/web/client/vite.config.ts",
    "build": "npm run build:core && npm run build:modules && npm run build:web",
    "build:core": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:modules": "tsc -p tsconfig.modules.json",
    "build:web": "vue-tsc --noEmit -p tsconfig.web.json && vite build --config src/web/client/vite.config.ts",
    "build:fleet": "npm run build:core && tsc -p tsconfig.fleet.json && npm run build:web",
    "start": "node dist/index.js",
    "module": "tsx src/cli/nano-cli.ts",
    "ui": "tsx src/tui/index.tsx",
    "doctor": "tsx src/cli/nano-cli.ts doctor",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "precommit": "npx lint-staged",
    "dashboard": "tsx src/cli/nano-cli.ts dashboard",
    "scaffold": "tsx src/cli/nano-cli.ts scaffold",
    "audit:isolation": "tsx src/cli/nano-cli.ts isolation"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache --fix"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "better-sqlite3": "^12.11.1",
    "croner": "^10.0.1",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "jiti": "^2.6.1",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "smol-toml": "^1.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@inkjs/ui": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.17",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.0.16",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-formatter-unix": "^9.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^61.5.0",
    "eslint-plugin-prefer-optional-chaining": "^0.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "fullscreen-ink": "^0.1.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.7",
    "sass": "^1.102.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
